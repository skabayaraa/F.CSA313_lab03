



import http from 'k6/http';
g
import { check, sleep } from 'k6';

export const options = {
  vus: 20,
  duration: '2m',
  thresholds: {
    'http_req_duration{name:cart}': ['p(95)<200'],
    'http_req_duration{name:report}': ['p(95)<450'],
    'http_req_failed{name:pay}': ['rate<0.08'], // 5% алдаа гарч магадгүй тул 80%-иас доош байх
    'checks': ['rate>0.90'],
  },
};

export default function () {
  // 1) Cart add хүсэлт
  let resCart = http.post('http://localhost:3000/cart/add', JSON.stringify({ productId: 1 }), {
    headers: { 'Content-Type': 'application/json' },
    timeout: '10s',
    tags: { name: 'cart' },
  });

  check(resCart, {
    'cart status is 200': (r) => r.status === 200,
  });

  sleep(1);

  // 2) Report хүсэлт
  let resReport = http.get('http://localhost:3000/report', {
    timeout: '10s',
    tags: { name: 'report' },
  });

  check(resReport, {
    'report status is 200': (r) => r.status === 200,
  });

  sleep(1);

  // 3) Pay хүсэлт
  let resPay = http.post('http://localhost:3000/pay', JSON.stringify({ amount: 5000 }), {
    headers: { 'Content-Type': 'application/json' },
    timeout: '10s',
    tags: { name: 'pay' },
  });

  check(resPay, {
    'pay status is 200 or 500': (r) => r.status === 200 || r.status === 500,
  });

  sleep(1);
}
